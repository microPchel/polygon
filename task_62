class Solution {
public:
    int uniquePaths(int m, int n) {
        vector<vector<int>> matrix(m, vector<int>(n, 1)); // 24 байта + n * 4 байта
        for(int i = 1; i < m; i++) // O(n)
        {
            for(int j = 1; j < n; j++) // O(n)
                {
                    matrix[i][j] = matrix[i-1][j] + matrix[i][j-1];;
                }
        }
        return matrix[m-1][n-1];
    }
};
