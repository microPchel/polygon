#include <vector>

int maxSequence(const std::vector<int>& arr){
  if (arr.empty()) return 0; 

    int maxSoFar = 0; // 4 байта
    int maxEndingHere = 0; // 4 байта

    for (size_t i = 0; i < arr.size(); ++i) { // O(n)
        maxEndingHere += arr[i]; 
        if (maxEndingHere < 0) { // O(1)
            maxEndingHere = 0;
        }
        maxSoFar = std::max(maxSoFar, maxEndingHere);
    }
    return maxSoFar;
}
