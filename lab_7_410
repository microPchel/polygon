class Solution {
public:
     int splitArray(vector<int>& nums, int k) {
        int left = *max_element(nums.begin(), nums.end()); //4 байта
        int right = accumulate(nums.begin(), nums.end(), 0); //4 байта
        
        // O(n)
        while (left < right) {
            int mid = left + (right - left) / 2; // 4 байта
        
            if (Drob(nums, mid, k)) {
                right = mid; 
            } else {
                left = mid + 1; 
            }
        }
        return left;
    }
     bool Drob(vector<int>& nums, int max_sum, int k) {
        int current_sum = 0; // 4 байта 
        int count = 1; // 4 байта

        for (int num : nums) { //O(n)
            current_sum += num;

            if (current_sum > max_sum) {
                count++; 
                current_sum = num; 
                if (count > k) {
                    return false; 
                }
            }
        }
        return true; 
    }
};
